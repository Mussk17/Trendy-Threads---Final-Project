# Trendy Threads – Environment variables
# Copy this file to .env and fill in your values. Never commit .env.

# Django
SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Stripe (https://dashboard.stripe.com/apikeys – use Test mode for development)
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: base URL for Stripe success/cancel redirects
# DOMAIN=http://localhost:8000

# AWS Bedrock (Knowledge Base RAG chatbot)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_KNOWLEDGE_BASE_ID=

# Optional overrides
# BEDROCK_MODEL_ARN=arn:aws:bedrock:us-east-1::foundation-model/anthropic.claude-3-haiku-20240307-v1:0
# S3_POLICY_BUCKET=your-policy-docs-bucket-name
# DEFAULT_FROM_EMAIL=Trendy Threads <noreply@trendythreads.com>
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
